            : "${params.container_registry}/${params.image_python_utils}:${params.container_tag}"

/*
 * ============================================================
 * PROCESS -> CONTAINER MAPPINGS
 * ============================================================
 *
 * Shared by Docker and Apptainer.
 */

process {
    container = params.default_container

    // QC / read processing
    withName: 'Quality_Control'                 { container = params.aio_qc_container }
    withName: 'PoreChop'                        { container = params.aio_qc_container }
    withName: 'Read_Distribution'               { container = params.aio_qc_container }
    withName: 'Map_Reads_2_RefSeq'              { container = params.aio_qc_container }
    withName: 'Split_Short_Reads'               { container = params.aio_qc_container }
    withName: 'Split_Long_Reads'                { container = params.aio_qc_container }
    withName: 'Subassembly'                     { container = params.aio_qc_container }
    withName: 'Interleave'                      { container = params.interleave_container }
    withName: 'Split_Interleave'                { container = params.bbmap_container }
    withName: 'Remove_Common_Flora_rRNA_reads'  { container = params.bbmap_container }
    withName: 'Fastp_LongReads'                 { container = params.fastp_long_container }

    withName: 'Pretrim_fastqc_merged'            { container = params.fastqc_container }
    withName: 'Pretrim_fastqc'                   { container = params.fastqc_container }
    withName: 'Post_trim_fastqc'                 { container = params.fastqc_container }
    withName: 'Post_host_remove_fastqc'          { container = params.fastqc_container }
    withName: 'Post_removal_rRNA_reads_fastqc'  { container = params.fastqc_container }

    withName: 'Multiqc_QC_Stats'                 { container = params.multiqc_container }
    withName: 'Multiqc_QC_host_removal'          { container = params.multiqc_container }
    withName: 'Multiqc_QC_rRNA_removal'          { container = params.multiqc_container }

    withName: 'Pretrim_NanoPlot'                 { container = params.nanoplot_container }
    withName: 'Posttrim_NanoPlot'                { container = params.nanoplot_container }
    withName: 'LongRead_NanoPlot_QC_Stats'       { container = params.nanoplot_container }

    // rRNA removal
    withName: 'RiboDetector_Remove_rRNA_reads' {
        maxForks = 1
    }

    withLabel: ribodetector {
        container = params.ribodetector_container

        containerOptions = {
            def mode = (params.ribodetector_mode ?: 'cpu').toString().toLowerCase()
            mode == 'gpu' ? '--nv' : ''
        }

        clusterOptions = {
            def mode = (params.ribodetector_mode ?: 'cpu').toString().toLowerCase()
            mode == 'gpu' ? '--gpus=1 --cpus-per-task=1' : ''
        }
    }

    // Assembly
    withName: 'Spades'                { container = params.spades_container }
    withName: 'MetaSPAdes_Assembly'   { container = params.spades_container }
    withName: 'Plasmid_Spades'        { container = params.spades_container }
    withName: 'Unicycler_Assembly'    { container = params.unicycler_container }
    withName: 'Dragonflye'            { container = params.dragonflye_container }
    withName: 'Dragonflye_Raven'      { container = params.dragonflye_container }
    withName: 'Dragonflye_Medaka'     { container = params.dragonflye_container }
    withName: 'Myloasm'               { container = params.myloasm_container }

    withName: '(?i).*autocycler.*|EstimateGenomeSize|SubsampleReads|AssembleFlye|AssembleMyloasm|AssembleMiniasm|CompressAssemblies|ClusterAssemblies|TrimClusters|ResolveClusters|CombineResolved' {
        container = params.autocycler_container
    }

    // Search
    withName: 'BlastX_contigs'            { container = params.diamond_container }
    withName: 'BlastX_reads'              { container = params.diamond_container }
    withName: 'DAA2INFO_contigs_daa_file' { container = params.diamond_container }

    withName: '.*MMSEQS.*' {
        container = params.mmseqs2_container
        scratch = '/tmp'
    }

    withName: '.*MEGAN.*' {
        scratch = '/tmp'
    }

    withName: 'BLASTN_NT_contigs'      { container = params.blast_container }
    withName: 'AMR_VF_BLAST'           { container = params.blast_container }
    withName: 'AMR_VF_BLAST_UNMAPPED'  { container = params.blast_container }

    // Taxonomy
    withLabel: kraken2    { container = params.kraken2_container }
    withName: 'MASH'      { container = params.kraken2_container }
    withLabel: sourmash   { container = params.sourmash_container }
    withLabel: metaphlan4 { container = params.metaphlan4_container }
    withLabel: gottcha    { container = params.gottcha_container }
    withLabel: taxpasta   { container = params.taxpasta_container }
    withLabel: krona      { container = params.krona_container }

    // Genome / contig characterization
    withName: 'BUSCO'             { container = params.busco_container }
    withName: 'CheckM_Assemblies' { container = params.checkm_container }
    withName: 'CheckM2_Assemblies'{ container = params.checkm2_container }
    withName: 'CheckV_Assemblies' { container = params.checkv_container }

    withName: '.*AMRFINDER.*' {
        container = params.amrfinder_container
        maxForks = 1
    }

    withName: '.*RGI.*' {
        container = params.rgi_container
        containerOptions = "--env RGI_DB_PATH=${params.database_dir}/card-data/"
    }

    withName: 'MLST'     { container = params.mlst_container }
    withName: 'PROKKA'   { container = params.prokka_container }
    withName: 'PHISPY'   { container = params.phispy_container }

    withName: 'MOBSUITE' {
        container = params.mobsuite_container
        containerOptions = "-B ${params.mobsuite_db_host}:/usr/local/lib/python3.11/site-packages/mob_suite/databases"
    }

    withName: 'PLASME' {
        container = params.plasme_container
    }

    // VirusSeeker
    withName: 'Generate_VS_Outputs' {
        container = params.virusseeker_container
    }

    // Generic Python parsers
    withName: 'Parse_.*' {
        container = params.python_utils_container
    }
}
