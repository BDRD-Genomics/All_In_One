/*
 * ============================================================
 * ALL_IN_ONE CONTAINER DEFINITIONS
 * ============================================================
 *
 * Docker online:
 *   ghcr.io/bdrd-genomics/allinone-<tool>:<tag>
 *
 * Apptainer online:
 *   docker://ghcr.io/bdrd-genomics/allinone-<tool>:<tag>
 *
 * Apptainer offline:
 *   <container_dir>/allinone-<tool>.sif
 *
 * Default tag: latest
 * Override: --container_tag 1.0.2
 *
 * NOTE: no top-level helper closure is used here, which avoids
 * the Nextflow 26 strict-parser issue you hit earlier.
 */

params.container_registry = params.container_registry ?: 'ghcr.io/bdrd-genomics'
params.container_tag      = params.container_tag      ?: 'latest'
params.container_runtime  = params.container_runtime  ?: 'apptainer'
params.offline            = params.offline            ?: false

params.container_dir =
    params.container_dir ?:
    System.getenv('AIO_CONTAINER_DIR') ?:
    "${projectDir}/containers/apptainer"

/* IMAGE NAMES */
params.image_default = 'allinone-conda-base'
params.image_aio_qc = 'allinone-aio_qc'
params.image_bbmap = 'allinone-bbmap'
params.image_interleave = 'allinone-interleave'
params.image_fastp_long = 'allinone-fastp_long'
params.image_fastqc = 'allinone-fastqc'
params.image_multiqc = 'allinone-multiqc'
params.image_nanoplot = 'allinone-nanoplot'
params.image_blast = 'allinone-blast'
params.image_diamond = 'allinone-diamond'
params.image_mmseqs2 = 'allinone-mmseqs2'
params.image_spades = 'allinone-spades'
params.image_unicycler = 'allinone-unicycler'
params.image_dragonflye = 'allinone-dragonflye'
params.image_myloasm = 'allinone-myloasm'
params.image_autocycler = 'allinone-autocycler'
params.image_kraken2 = 'allinone-kraken2'
params.image_sourmash = 'allinone-sourmash'
params.image_metaphlan4 = 'allinone-metaphlan4'
params.image_gottcha = 'allinone-gottcha2'
params.image_taxpasta = 'allinone-taxpasta'
params.image_krona = 'allinone-krona'
params.image_busco = 'allinone-busco'
params.image_checkm = 'allinone-checkm-genome'
params.image_checkm2 = 'allinone-checkm2'
params.image_checkv = 'allinone-checkv'
params.image_amrfinder = 'allinone-amrfinder_plus'
params.image_rgi = 'allinone-rgi'
params.image_mlst = 'allinone-mlst'
params.image_prokka = 'allinone-prokka'
params.image_phispy = 'allinone-phispy'
params.image_mobsuite = 'allinone-mobsuite'
params.image_plasme = 'allinone-plasme'
params.image_ribodetector = 'allinone-ribodetector'
params.image_virusseeker = 'allinone-vs'
params.image_python_utils = 'allinone-python_utils'


/* RESOLVED CONTAINER REFERENCES */

params.default_container =
    params.offline && params.container_runtime == 'apptainer'
        ? "${params.container_dir}/${params.image_default}.sif"
        : params.container_runtime == 'apptainer'
            ? "docker://${params.container_registry}/${params.image_default}:${params.container_tag}"
            : "${params.container_registry}/${params.image_default}:${params.container_tag}"

