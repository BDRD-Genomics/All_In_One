/*
 * ============================================================
 * DATABASE / REFERENCE DEFINITIONS
 * ============================================================
 *
 * Root directories come from site.config.
 */

params {
    // rRNA / host-removal references
    host_db_silva   = "${params.legacy_database_dir}/bbmap/silva_release138_LSU-SSU_NR99_rRNA/SILVA_138.1_LSU-SSU_NR99_tax_silva.fasta"
    bbmap_ref_silva = "${params.legacy_database_dir}/bbmap/silva_release138_LSU-SSU_NR99_rRNA"

    // CheckM / CheckM2 / CheckV
    checkm_data_dir = "${params.database_dir}/checkm"
    checkm2_db      = "${params.database_dir}/checkm2/CheckM2_database/uniref100.KO.1.dmnd"
    checkv_db       = "${params.database_dir}/checkv/checkv-db-v1.5"

    // DIAMOND / MEGAN / VirusSeeker
    diamond_dbdir             = "${params.legacy_database_dir}/blastdb/nr/nr"
    diamond_dbdir_small_toxin = "${params.legacy_database_dir}/small_toxin/protein/small_toxins_db"
    megandb                   = "${params.legacy_database_dir}/nf_taxonomy_sqlite/megan_db"
    ncbi_taxa                 = "${params.legacy_database_dir}/taxonomy/taxa.sqlite"
    vhunter                   = "${params.legacy_database_dir}/nf_taxonomy_sqlite/megan_db/megan-map.updated.db"

    // Repository-bundled resource
    bad_accessions_list = "${projectDir}/scripts/bad_nt_acc.txt"

    // MMseqs2
    mmseq_tmp_dir = params.tmp_dir
    mmseqs_nt_db  = "${params.legacy_database_dir}/mmseqs/nt/nt"
    db_BN         = "${params.legacy_database_dir}/mmseqs/core_nt/core_nt"

    // Read taxonomic classification
    kraken2_db    = "${params.database_dir}/kraken2/k2_core_nt"
    krona_db      = "${params.database_dir}/krona/taxonomy"
    sourmash_db   = "${params.database_dir}/sourmash/gtdb-rs226-k21.dna.rocksdb"
    mash_db       = "${params.legacy_database_dir}/mash/refseq.genomes+plasmid.k21s1000.msh"
    metaphlan4_db = "${params.data_database_dir}/metaphlan4"
    gottcha_db    = "${params.data_database_dir}/gottcha/gottcha_db"
    vfdb          = "${params.legacy_database_dir}/vfdb/VFDB_setB_pro.fas"

    // Contig characterization
    busco_db          = "${params.database_dir}/busco"
    addgeneDB         = "${params.database_dir}/blastdb/addgene_plasmids/addgene_plasmids"
    snapgeneDB        = "${params.database_dir}/blastdb/snapgene_plasmids/snapgene_plasmids"
    vfdb_nt           = "${params.database_dir}/blastdb/vfdb_nt/vfdb_nt"
    AMR_CDS           = "${params.database_dir}/blastdb/AMR_CDS/AMR_CDS"
    selectAgents_nuc  = "${params.database_dir}/select_agents/select_agents_nuc/select_agents_nucleotide"
    vfdb_prot         = "${params.database_dir}/blastdb/vfdb_prot/vfdb_prot"
    AMR_Prot          = "${params.database_dir}/blastdb/AMRProt/AMRProt"
    selectAgents_prot = "${params.database_dir}/select_agents/select_agents_toxins_prot/select_agents_toxins"
    amrfinderDB       = "${params.database_dir}/amrfinderplus/latest"
    plasme_db         = "${params.database_dir}/PLASMe/DB"
    blast_core_nt     = "${params.database_dir}/blastdb/core_nt/core_nt"

    // Automated read mapping
    readmapping_auto_gcf_genomes_dir    = "${params.database_dir}/GCF"
    readmapping_auto_refseq_prok_dir    = "${params.database_dir}/blastdb/ref_prok_rep_genomes"
    readmapping_auto_refseq_viruses_dir = "${params.database_dir}/blastdb/ref_viruses_rep_genomes"
    assembly_summary_refseq             = "${params.database_dir}/assembly_summary_refseq.txt"
    assembly_summary_refseq_historical  = "${params.database_dir}/assembly_summary_refseq_historical.txt"

    // MOB-suite host database location
    mobsuite_db_host = "${params.database_dir}/mob_suite"
}
