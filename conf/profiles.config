/*
 * ============================================================
 * EXECUTION + SOFTWARE BACKEND PROFILES
 * ============================================================
 */

profiles {
    local {
        process.executor = 'local'
        process.memory   = '32 GB'
        process.cpus     = 6
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
        queueSize        = 10000
        process.scratch  = params.tmp_dir
    }

    conda {
        docker.enabled    = false
        apptainer.enabled = false
        conda.enabled     = true
        conda.cacheDir    = params.conda_cache_dir

        process {
            // Fallback for processes without a dedicated YAML.
            conda = params.conda_env_all_in_one

            // CLC is external/proprietary software and runs on the host.
            withName: '.*Assembly_Workflow:CLC_Assembly.*' {
                conda = null
            }

            // QC / read processing
            withName: 'Quality_Control'              { conda = params.conda_env_aio_qc }
            withName: 'PoreChop'                     { conda = params.conda_env_fastp_long }
            withName: 'Pretrim_fastqc_merged'        { conda = params.conda_env_fastqc }
            withName: 'Pretrim_fastqc'               { conda = params.conda_env_fastqc }
            withName: 'Post_trim_fastqc'             { conda = params.conda_env_fastqc }
            withName: 'Post_host_remove_fastqc'      { conda = params.conda_env_fastqc }
            withName: 'Post_removal_rRNA_reads_fastqc' { conda = params.conda_env_fastqc }
            withName: 'Multiqc_QC_Stats'             { conda = params.conda_env_multiqc }
            withName: 'Multiqc_QC_host_removal'      { conda = params.conda_env_multiqc }
            withName: 'Multiqc_QC_rRNA_removal'      { conda = params.conda_env_multiqc }
            withName: 'Fastp_LongReads'              { conda = params.conda_env_fastp_long }
            withName: 'Pretrim_NanoPlot'             { conda = params.conda_env_nanoplot }
            withName: 'Posttrim_NanoPlot'            { conda = params.conda_env_nanoplot }
            withName: 'LongRead_NanoPlot_QC_Stats'   { conda = params.conda_env_nanoplot }
            withName: 'Remove_Common_Flora_rRNA_reads' { conda = params.conda_env_bbmap }

            // BLAST / DIAMOND / MMseqs2
            withName: 'BlastX_contigs' { conda = params.conda_env_diamond }
            withName: 'BlastX_reads'   { conda = params.conda_env_diamond }
            withName: '.*MMSEQS.*' {
                conda = params.conda_env_mmseqs2
                scratch = '/tmp'
            }

            // Assemblers
            withName: '(?i).*spades.*'     { conda = params.conda_env_spades }
            withName: '(?i).*unicycler.*'  { conda = params.conda_env_unicycler }
            withName: '(?i).*dragonflye.*' { conda = params.conda_env_dragonflye }
            withName: '(?i).*autocycler.*|EstimateGenomeSize|SubsampleReads|AssembleFlye|AssembleMyloasm|AssembleMiniasm|CompressAssemblies|ClusterAssemblies|TrimClusters|ResolveClusters|CombineResolved' { conda = params.conda_env_autocycler }
            withName: 'Myloasm'         { conda = params.conda_env_myloasm }

            // Taxonomy
            withLabel: kraken2 { conda = params.conda_env_kraken2 }
            withLabel: sourmash { conda = params.conda_env_kraken2 }
            withLabel: taxpasta { conda = params.conda_env_kraken2 }
            withLabel: metaphlan4 { conda = params.conda_env_kraken2 }
            withLabel: gottcha { conda = params.conda_env_kraken2 }
            withName: 'BRACKEN_ABUNDANCE' { conda = params.conda_env_kraken2 }
            withName: 'MASH' { conda = params.conda_env_kraken2 }

            // Contig / genome characterization
            withName: 'PROKKA'           { conda = params.conda_env_prokka }
            withName: 'BUSCO'            { conda = params.conda_env_busco }
            withName: 'CheckM_Assemblies' { conda = params.conda_env_checkm_genome }
            withName: 'MLST'             { conda = params.conda_env_mlst }
            withName: '.*AMRFINDER.*' {
                conda = params.conda_env_amrfinderplus
                maxForks = 1
            }
            withName: '.*RGI.*'          { conda = params.conda_env_rgi }
            withName: 'Generate_VS_Outputs' { conda = params.conda_env_vs }
            withName: 'Parse_.*' { conda = params.conda_env_python_utils }
            withName: 'Exercise_.*' { conda = params.conda_env_python_reports }
            withLabel: readmapping_auto { conda = params.conda_env_readmapping_auto }
            withName: 'CHIMERIC_DETECTION' { conda = params.conda_env_chimeric }
            withName: 'UNMAPPED_CHIMERIC_DETECTION' { conda = params.conda_env_chimeric }
        }
    }

    docker {
        apptainer.enabled = false
        env.TMPDIR    = params.tmp_dir
        docker.temp   = params.tmp_dir
        docker.enabled = true
        conda.enabled  = false

        process {
            container = params.docker_image

            withName: '.*Assembly_Workflow:CLC_Assembly.*' {
                container = null
            }
        }

        docker.runOptions = """
            -v ${params.database_dir}:${params.database_dir}
            -v ${params.data_database_dir}:${params.data_database_dir}
            -v ${params.legacy_database_dir}:${params.legacy_database_dir}
        """
    }

    apptainer {
        process.scratch       = params.tmp_dir
        apptainer.enabled     = true
        docker.enabled        = false
        conda.enabled         = false
        apptainer.autoMounts  = true
        apptainer.envWhitelist = 'TMPDIR,TMP,TEMP'

        apptainer.runOptions = "--cleanenv --bind ${params.database_dir}:${params.database_dir},${params.legacy_database_dir}:${params.legacy_database_dir},${params.data_database_dir}:${params.data_database_dir},${params.tmp_dir}:/tmp"

        process {
            container = params.default_container

            withName: VF_CLASSIFIER {
                cpus   = 8
                memory = '32 GB'
                time   = '8h'
                container = params.vf_classifier_sif
                containerOptions = params.vf_gpu ? '--nv' : ''
                clusterOptions = params.vf_gpu ? '--gpus=1 --cpus-per-task=1' : ''
            }

            withName: '.*MMSEQS.*' {
                scratch = '/tmp'
            }

            withName: '.*MEGAN.*' {
                scratch = '/tmp'
            }

            // CLC is installed on the host and intentionally runs outside Apptainer.
            withName: '.*Assembly_Workflow:CLC_Assembly.*' {
                container = null
            }

            withName: '.*Exercise.*' {
                container = params.report_container
            }

            withName: 'Fastp_LongReads' {
                container = params.fastp_long_container
            }

            withName: 'Posttrim_NanoPlot' {
                container = params.nanoplot_container
            }

            withName: 'Pretrim_NanoPlot' {
                container = params.nanoplot_container
            }

            withName: 'Interleave' {
                container = params.interleave_container
            }

            withName: 'Pretrim_fastqc_merged' {
                container = params.default_container
            }

            withName: 'Pretrim_fastqc' {
                container = params.default_container
            }

            withName: 'Quality_Control' {
                container = params.aio_qc_container
            }

            withName: 'PoreChop' {
                container = params.aio_qc_container
            }

            withName: 'Post_trim_fastqc' {
                container = params.default_container
            }

            withName: 'Multiqc_QC_Stats' {
                container = params.default_container
            }

            withName: 'Read_Distribution' {
                container = params.aio_qc_container
            }

            withName: 'Map_Reads_2_RefSeq' {
                container = params.aio_qc_container
            }

            withName: 'Post_host_remove_fastqc' {
                container = params.aio_qc_container
            }

            withName: 'Multiqc_QC_host_removal' {
                container = params.aio_qc_container
            }

            withName: 'Multiqc_QC_rRNA_removal' {
                container = params.aio_qc_container
            }

            withName: 'Post_removal_rRNA_reads_fastqc' {
                container = params.aio_qc_container
            }

            withName: 'Remove_Common_Flora_rRNA_reads' {
                container = params.bbmap_container
            }

            withName: RiboDetector_Remove_rRNA_reads {
                maxForks = 1
            }

            withLabel: 'ribodetector' {
                container = params.ribodetector_container

                containerOptions = {
                    def mode = (params.ribodetector_mode ?: 'cpu').toString().toLowerCase()
                    mode == 'gpu' ? '--nv' : ''
                }

                clusterOptions = {
                    def mode = (params.ribodetector_mode ?: 'cpu').toString().toLowerCase()
                    mode == 'gpu' ? '--gpus=1 --cpus-per-task=1' : ''
                }
            }

            withName: 'BlastX_contigs' {
                container = params.diamond_container
            }

            withName: 'BlastX_reads' {
                container = params.diamond_container
            }

            withName: 'Generate_VS_Outputs' {
                container = params.virusseeker_container
            }

            withName: 'CheckM2_Assemblies' {
                container = params.checkm2_container
            }

            withName: 'CheckV_Assemblies' {
                container = params.checkv_container
            }

            withName: '.*RGI.*' {
                container = params.rgi_container
                containerOptions = "--env RGI_DB_PATH=${params.database_dir}/card-data/"
            }

            withName: 'PLASME' {
                container = params.plasme_container
            }

            withName: 'PROKKA' {
                container = params.prokka_container
            }

            withName: 'MOBSUITE' {
                container = params.mobsuite_container
                containerOptions = "-B ${params.mobsuite_db_host}:/usr/local/lib/python3.11/site-packages/mob_suite/databases"
            }

            withName: 'LongRead_NanoPlot_QC_Stats' {
                container = params.nanoplot_container
            }

            withName: 'MLST' {
                container = params.mlst_container
            }

            withName: 'BUSCO' {
                container = params.busco_container
            }

            withName: '.*AMRFINDER.*' {
                container = params.amrfinder_container
                maxForks = 1
            }

            withName: 'CheckM_Assemblies' {
                container = params.checkm_container
            }

            withName: 'PHISPY' {
                container = params.phispy_container
            }


            withLabel: kraken2 {
                container = params.kraken2_container
            }

            withLabel: sourmash {
                container = params.sourmash_container
            }

            withLabel: taxpasta {
                container = params.taxpasta_container
            }

            withLabel: metaphlan4 {
                container = params.metaphlan4_container
            }

            withLabel: gottcha {
                container = params.gottcha_container
            }
        }
    }
}
