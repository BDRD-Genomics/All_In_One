/*
 * ============================================================
 * BACKEND-NEUTRAL PROCESS RESOURCES
 * ============================================================
 *
 * No container or Conda directives belong here.
 */

process {
    scratch = params.tmp_dir

    withName: 'Autocycler_Workflow:ClusterAssemblies' {
        shell = ['/bin/bash', '-e', '-o', 'pipefail']
    }

    withName: 'PROKKA' {
        scratch = true
        beforeScript = '''
            export TMPDIR="$PWD/tmp"
            export TEMP="$PWD/tmp"
            export TMP="$PWD/tmp"
            mkdir -p "$TMPDIR"
        '''
    }

    withName: 'BUSCO' {
        scratch = true
        beforeScript = '''
            export TMPDIR="$PWD/tmp"
            export TEMP="$PWD/tmp"
            export TMP="$PWD/tmp"
            mkdir -p "$TMPDIR"
        '''
    }

    withLabel: process_clc {
        cpus = 2
        memory = '4 GB'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=2 --mem=4G'
    }

    withLabel: kraken2 {
        cpus = 32
        memory = '280 GB'
        time = '24h'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=32 --mem=280G'
    }

    withLabel: sourmash {
        cpus = 4
        memory = '8 GB'
        time = '12h'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=4 --mem=8G'
    }

    withLabel: taxpasta {
        cpus = 2
        memory = '4 GB'
        time = '4h'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=2 --mem=4G'
    }

    withLabel: metaphlan4 {
        cpus = 8
        memory = '32 GB'
        time = '24h'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=8 --mem=32G'
    }

    withLabel: gottcha {
        cpus = 8
        memory = '32 GB'
        time = '24h'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=8 --mem=32G'
    }

    withLabel: summary {
        cpus = 1
        memory = '1 GB'
        time = '1h'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=1 --mem=1G'
    }

    withLabel: autocycler_mem {
        cpus = 254
        memory = '996 GB'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=254 --mem=996G'
    }

    withLabel: optimized_split_interleaved {
        cpus = 4
        memory = '8 GB'
        time = '3h'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=4 --mem=8G'
    }

    withLabel: lowmem {
        cpus = 8
        memory = '24 GB'
        cache = 'deep'
        clusterOptions = '--cpus-per-task=8 --mem=24G'
    }

    withLabel: optimized_Meganize_ShortReads_BlastX {
        cpus = 4
        memory = '307 GB'
        clusterOptions = '--cpus-per-task=4 --mem=307G'
    }

    withLabel: optimized_Meganize_Contigs_BlastX {
        cpus = 16
        memory = '128 GB'
        clusterOptions = '--cpus-per-task=16 --mem=128G'
    }

    withLabel: megan {
        cpus = 16
        memory = '128 GB'
        clusterOptions = '--cpus-per-task=16 --mem=128G'
    }

    withLabel: optimized_blastx_reads {
        cpus = 82
        memory = '254 GB'
        clusterOptions = '--cpus-per-task=82 --mem=254G'
    }

    withLabel: optimized_blastx_contigs {
        cpus = 82
        memory = '254 GB'
        clusterOptions = '--cpus-per-task=82 --mem=254G'
    }

    withLabel: optimized_MMSEQ_contigs_against_NT_metaspades {
        cpus = 30
        memory = '64 GB'
        clusterOptions = '--cpus-per-task=30 --mem=64G'
    }

    withLabel: optimized_MMSEQ_SEARCH {
        cpus = 254
        memory = '996 GB'
        clusterOptions = '--cpus-per-task=254 --mem=996G'
    }

    withLabel: medaka_gpu {
        cpus = 30
        memory = '64 GB'
        clusterOptions = '--cpus-per-task=30 --mem=64G --gpus=2'
    }

    withLabel: no_fips {
        cpus = 30
        memory = '64 GB'
        clusterOptions = '--partition=nofips --cpus-per-task=30 --mem=64G'
    }

    withLabel: qc {
        cpus = 16
        memory = '32 GB'
        clusterOptions = '--cpus-per-task=16 --mem=32G'
    }
}
