/*
 * ============================================================
 * CONDA ENVIRONMENT DEFINITIONS
 * ============================================================
 *
 * Environments are repository-relative so the same checkout works on
 * local, SLURM, and offline systems without installation-specific paths.
 */

params {
    // Broad fallback environment
    conda_env_all_in_one = "${projectDir}/env/all_in_one_requirements.yml"

    // QC / read processing
    conda_env_aio_qc     = "${projectDir}/env/environment.aio_qc.yml"
    conda_env_fastqc     = "${projectDir}/env/environment.fastqc.yml"
    conda_env_fastp_long = "${projectDir}/env/environment.longread_qc.yml"
    conda_env_multiqc    = "${projectDir}/env/environment.aio_qc.yml"
    conda_env_nanoplot   = "${projectDir}/env/environment.longread_qc.yml"
    conda_env_bbmap      = "${projectDir}/env/environment.aio_qc.yml"

    // Search / taxonomy
    conda_env_blast      = "${projectDir}/env/environment.search.yml"
    conda_env_diamond    = "${projectDir}/env/environment.search.yml"
    conda_env_mmseqs2    = "${projectDir}/env/environment.search.yml"
    conda_env_kraken2    = "${projectDir}/env/environment.taxonomy.yml"
    conda_env_krona      = "${projectDir}/env/environment.taxonomy.yml"

    // Assembly
    conda_env_spades     = "${projectDir}/env/environment.assembly.yml"
    conda_env_unicycler  = "${projectDir}/env/environment.assembly.yml"
    conda_env_dragonflye = "${projectDir}/env/environment.assembly.yml"
    conda_env_autocycler = "${projectDir}/env/environment.autocycler.yml"
    conda_env_myloasm    = "${projectDir}/env/environment.myloasm.yml"

    // Characterization
    conda_env_busco         = "${projectDir}/env/environment.busco.yml"
    conda_env_checkm_genome = "${projectDir}/env/environment.checkm.yml"
    conda_env_amrfinderplus = "${projectDir}/env/environment.amrfinderplus.yml"
    conda_env_prokka        = "${projectDir}/env/environment.prokka.yml"
    conda_env_rgi           = "${projectDir}/env/environment.rgi.yml"
    conda_env_mlst          = "${projectDir}/env/environment.mlst.yml"
    conda_env_python_utils  = "${projectDir}/env/environment.python_utils.yml"
    conda_env_python_reports = "${projectDir}/env/environment.python_reports.yml"

    // Specialized workflows
    conda_env_md = "${projectDir}/env/md.yaml"
    conda_env_vs = "${projectDir}/env/vs.yml"
}
