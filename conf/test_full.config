params {

    /*
     * ==============================
     * Full reviewer integration test
     * ==============================
     */

    database_dir = "${projectDir}/tests/databases"

    test = true

    run_id = "nf_test_full"

    outdir = "${launchDir}/test_results/full"


    /*
     * ==============================
     * Core analysis
     * ==============================
     */

    run_qc_stats = true

    agnostic_read_analysis = true

    map2reads = true
    host_db = "${projectDir}/tests/data/reference/test_reference.fasta"
    remove_rRNA_reads = true
    ribodetector_mode = 'gpu'
    rRNA_method       = 'ribodetector'

    /*
     * ==============================
     * Assembly
     * ==============================
     */

    run_assembly = true


    /*
     * ==============================
     * Sequence searches
     * ==============================
     */

    run_blastx = true


    /*
     * ==============================
     * Database-dependent analyses
     * ==============================
     */

    amr_vf = true

    amrfinder = true

    rgi = true

    mlst = true

    vs = true

    run_checkm = true

    run_checkm2 = true

    run_phispy = true

    run_mobsuite = true

    run_plasme = true
}


process {

    /*
     * Keep reviewer test resource requirements modest.
     */

    withName: 'QC_Workflow:Quality_Control' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'QC_Workflow:Interleave' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'QC_Workflow:Pretrim_fastqc_merged' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'QC_Workflow:Post_trim_fastqc' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'QC_Workflow:Pretrim_NanoPlot' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'QC_Workflow:Fastp_LongReads' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'QC_Workflow:PoreChop' {
        cpus = 2
        memory = '4 GB'
    }

    withName: 'Read_Distribution' {
        cpus = 2
        memory = '4 GB'
    }
}