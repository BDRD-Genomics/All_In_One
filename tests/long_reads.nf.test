nextflow_workflow {

    name "All_In_One long reads"

    script "../main.nf"

    config "./nextflow.config"


    params {

        samplesheet = "data/long/samplesheet.csv"

        run_id = "test_long"

        outdir = "results_long"

        shortreads = false
        longreads  = true
        hybrid     = false

    }


    test("long read workflow completes") {

        assert workflow.success

        assert path("results_long").exists()

    }

}