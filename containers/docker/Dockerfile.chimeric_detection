FROM ghcr.io/bdrd-genomics/allinone-conda-base:1.0.2

COPY environment.chimeric.yml /tmp/environment.yml

RUN /opt/conda/bin/mamba env create -n chimeric_detection -f /tmp/environment.yml \
    && /opt/conda/bin/conda clean -afy \
    && rm -f /tmp/environment.yml

ENV PATH=/opt/conda/envs/chimeric_detection/bin:$PATH
SHELL ["/bin/bash", "-lc"]
