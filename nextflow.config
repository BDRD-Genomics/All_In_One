/*
 * ============================================================
 * ALL-IN-ONE NEXTFLOW CONFIGURATION
 * ============================================================
 *
 */

includeConfig 'params.config'

// Portable defaults. Supply installation-specific overrides with
// `nextflow run main.nf -c site.config ...`.
includeConfig 'conf/site.config.example'
includeConfig 'conf/containers.config'
includeConfig 'conf/conda.config'
includeConfig 'conf/databases.config'
includeConfig 'conf/resources.config'
includeConfig 'conf/profiles.config'

env {
    TMPDIR = params.tmp_dir
    TEMP   = params.tmp_dir
    TMP    = params.tmp_dir
}

cleanup = params.cleanup
workDir = params.work_dir

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline.timeline_${params.trace_report_suffix}.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_${params.trace_report_suffix}.trace"
    overwrite = true
    append    = false
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline.report_${params.trace_report_suffix}.html"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline.dag_${params.trace_report_suffix}.svg"
    overwrite = true
}
