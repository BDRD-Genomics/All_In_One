params {
    /*
     * ============================================================
     * PIPELINE / RUN PARAMETERS
     * ============================================================
     *
     * Analysis Changes here e.g. --longreads = false/true
     * Installation-specific paths belong in site.config (databases, containers, etc.).
     */

    test_unmapped_reassembly = false

    samplesheet  = 'samplesheet.csv'
    run_qc       = true
    run_assembly = false
    project_id   = "YOU_FORGOT_TO_SET_THIS"

    // User output location. Override with --outdir if desired.
    outdir = "${launchDir}/results"

    // Pipeline-bundled scripts. This intentionally follows the Git repository.
    scripts = "${projectDir}/scripts"

    // Input type
    longreads  = false
    hybrid     = false
    shortreads = false

    // QC
    run_qc_stats = true
    trim         = true
    fastp_opts   = "-q 20 -e 20 --cut_front --cut_tail -w 16 -l 50"

    // Long-read QC
    fastp_long_opts = ''
    quality_phread_fastp_long = 8

    // Exercise report
    exercise_report = false

    // Agnostic read analysis
    agnostic_read_analysis = true

    // Remove host from reads
    map2reads = false
    host_db   = ""

    // BLASTX
    run_blastx = false

    // rRNA removal
    remove_rRNA_reads = false
    bbmap_args = "k=13 usemodulo=f rebuild=f interleaved=auto fastareadlen=500 unpigz=f touppercase=t "

    rRNA_method                      = 'bbmap_minimap2'
    ribodetector_mode                = 'cpu'
    ribodetector_short_len           = 100
    ribodetector_long_len            = 100
    ribodetector_ensure              = 'rrna'
    ribodetector_chunk_size          = 256
    ribodetector_cpu_cluster_options = ''
    ribodetector_gpu_cluster_options = '--gres=gpu:1'
    ribodetector_gpu_memory          = 4

    /*
     * Assembly
     */
    metaspades_default_cpus = 254
    metaspades_default_mem  = '500 GB'
    subassembly              = false
    metaspades               = false
    metaSPAdes               = "spades.py --only-assembler --tmp-dir ${params.tmp_dir} --meta"
    unicycler                = false
    unicycler_mode           = "normal"
    spades                   = false
    dragonflye               = false
    dragonflye_isolate       = false
    plasmidspades            = false

    // Myloasm
    myloasm        = false
    myloasm_hifi   = false
    myloasm_cpus   = 50
    myloasm_memory = '256 GB'
    myloasm_time   = '72h'
    myloasm_opts   = '--clean-dir'

    // Dragonflye / Raven
    dragonflye_opts        = '--trim --trimopts "--discard_middle" --depth 100 --opts "--iterations 5 --meta" --racon 3 --polypolish 5 --polypolish_careful --nanohq'
    raven_opts             = '--trim --trimopts "--discard_middle" --depth 0 --racon 3'
    dragonflye_min_quality = 8
    raven                  = false
    use_gsize              = false
    gsize                  = ""
    threads                = 8
    memory                 = 8
    medaka                 = false
    medaka_model           = ""

    // Dorado
    bam_file      = ""
    dorado_polish = false
    run_variant   = false

    // Nanopore assembly / specialized workflows
    nanopore_assembly = false
    vs                = false
    clc               = false

    /*
     * CLC assembly options
     */
    clc_grid                                      = 'slurm'
    clc_min_length                                = 1000
    clc_create_assembly_graph                     = true
    clc_create_report                             = true
    clc_keep_circular_contigs_under_len_threshold = false
    clc_report_export_format                      = 'export_pdf'
    clc_graph_export_format                       = ''

    /*
     * CheckM / CheckV
     */
    run_checkm  = true
    checkm_time = '36h'
    checkm_cpus = 32
    checkm_mem  = '64GB'

    /*
     * Autocycler
     */
    ac_enable_contig_filtering  = true
    ac_min_contig_len           = 1000
    ac_max_contigs_per_assembly = 25
    skip_subsample              = true
    subsample_count             = 6
    min_read_depth              = 25
    run_autocycler              = false
    autocycler_assemblers       = 'flye,miniasm,necat,myloasm'
    autocycler_subsamples       = 4
    use_flye                    = true
    use_miniasm                 = false
    use_necat                   = false
    use_myloasm                 = true

    // Hecatomb
    hecatomb_config = ""

    // DIAMOND
    diamond_args = "--block-size 20 --iterate faster --index-chunks 1 --tmpdir ${params.tmp_dir}"

    // MMseqs2
    run_mmseqs              = false
    mmseqs_search_max_seqs  = 20
    mmseqs_search_opts      = '--max-seqs 25 -s 7.0 -e 1.0E-8 --search-type 3 --split 0 --cov-mode 2 --cov 0.15'
    mmseqs_createdb_opts    = '--createdb-mode 1'
    mmseqs_format           = 'query,target,pident,alnlen,mismatch,gapopen,qstart,qend,tstart,tend,evalue,bits,theader,qlen,tlen'
    mmseqs_convertalis_opts = ""
    mmseqs_cpus             = 254
    mmseqs_mem              = 960
    db_BP                   = ""

    // Housekeeping
    cleanup  = null
    work_dir = "${launchDir}/work"

    /*
     * Read taxonomic classification
     */
    run_reads_taxonomic_classifier    = false
    run_kraken2                       = true
    run_sourmash                      = true
    run_mash                          = true
    run_metaphlan4                    = false
    run_gottcha                       = false
    run_taxpasta                      = true
    make_taxonomic_classifier_summary = true

    run_sourmash_kreport    = false
    sourmash_taxonomy       = ""
    sourmash_tax_extra_args = "--ignore-abund"

    kraken2_extra_args        = "--use-names --confidence 0.05"
    run_bracken               = true
    bracken_level             = 'S'
    bracken_threshold         = 1
    bracken_read_length_short = 150
    bracken_read_length_long  = 300
    bracken_extra_args        = ''

    sourmash_scaled_param = "k=21,scaled=1000"
    sourmash_extra_args   = ""

    metaphlan4_extra_args = ""
    metaphlan4_db_arg     = "--db_dir"
    gottcha_extra_args    = ""

    /*
     * VF classifier
     */
    vf_input_type = 'nucleotide'
    vf_mode       = 'isolate'
    vf_homology   = 'yes'
    vf_gpu        = true
    vf_threshold  = 0.34
    vf_classifier = false

    /*
     * Krona plots
     */
    krona_snapshot_width               = 1600
    krona_snapshot_height              = 1600
    krona_snapshot_wait_ms             = 1600
    krona_snapshot_popup_timeout_ms    = 30000
    krona_snapshot_download_timeout_ms = 30000
    krona_snapshot_png_width           = 1800
    krona_font                         = 15

    /*
     * Contig characterization
     */
    characterize_contigs = false
    prokka                = false
    busco                 = false
    amr_vf                = false
    mlst                  = false
    ge_screen             = false
    rgi                   = false
    amrfinder             = false
    chimeric_detection    = false
    blast_contigs         = true
    run_phispy            = false
    run_mobsuite          = false
    run_plasme            = false

    rgi_load_cmd = ''
    plasme_mode  = 'balance'

    /*
     * Automated read mapping
     */
    run_readmapping_auto           = false
    readmapping_auto_cluster_dedup = false
    readmapping_auto_ani_threshold = 99

    // Chimeric detection
    desired_rank    = "genus"
    max_target_seqs = 10

    // Timestamp used by trace/report/timeline/DAG output
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}
